{
  "name": "productos-retirados",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Comprueba si un producto está retirado en España.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "pipeline": "node pipeline/ejecutar.ts",
    "avisos": "node pipeline/avisos/telegram.ts",
    "tipos": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "verificar": "npm run tipos && npm run test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "^7.4.7",
    "fast-xml-parser": "^5.12.0",
    "node-html-parser": "^9.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "pagefind": "^1.6.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
