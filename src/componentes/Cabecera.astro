---
import Icono from './Icono.astro';
interface Props { titulo: string; icono?: string; color?: 'rosa' | 'agua' | 'crema' | 'cielo' }
const { titulo, icono, color } = Astro.props;
---

<header class:list={['cabecera', color && `c-${color}`]}>
  <div>
    <h1>{titulo}</h1>
    <slot />
  </div>
  {icono && <span class="cabecera-i"><Icono n={icono} /></span>}
</header>
