---
import { numero } from '../lib/formato';
import { ALTO, ANCHO, CEUTA, MELILLA, PROVINCIAS, RECUADRO, REGIONES, VECINOS } from '../lib/mapa-espana';
import { ruta } from '../lib/sitio';

interface Props { cuentas?: Record<string, number>; activas?: string[] }
const { cuentas, activas } = Astro.props;

const valores = Object.values(cuentas ?? {});
const minimo = Math.min(...valores);
const maximo = Math.max(...valores);
const tono = (v: number) => (maximo > minimo ? (v - minimo) / (maximo - minimo) : 1).toFixed(2);
const ranking = Object.entries(cuentas ?? {}).sort((a, b) => b[1] - a[1]);
const ETIQUETAS: [string, number, number, boolean?, boolean?][] = [
  ['PORTUGAL', 18, 262, false, true], ['FRANCIA', 442, 16], ['Mar Cantábrico', 292, 15, true],
  ['Océano Atlántico', 22, 362, true], ['Mar Mediterráneo', 524, 336, true],
];
const clases = (n: string) => ['ca', { on: activas?.includes(n) }];
---

<div class:list={[{ 'mapa-rej': cuentas }]}>
<figure class:list={['mapa', { 'mapa-f': !cuentas }]}>
  {activas && <p class="oculto">Comunidades afectadas: {activas.join(', ')}.</p>}
  <svg viewBox={`0 0 ${ANCHO} ${ALTO}`} aria-hidden={cuentas ? undefined : 'true'} role={cuentas ? 'group' : undefined} aria-label={cuentas ? 'Mapa de España por comunidad autónoma' : undefined}>
    <defs>
      <filter id="m-sombra" x="-5%" y="-5%" width="110%" height="110%"><feDropShadow dx="0" dy="0" stdDeviation="4" flood-color="#9fb6be" flood-opacity=".55" /><feDropShadow dx="0" dy="1.2" stdDeviation="1.2" flood-color="#1d2533" flood-opacity=".25" /></filter>
      <linearGradient id="m-mar" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e6eef1" /><stop offset="1" stop-color="#d9e4e8" /></linearGradient>
    </defs>
    <rect width={ANCHO} height={ALTO} fill="url(#m-mar)" />
    <path class="m-vecino" d={VECINOS} />
    {ETIQUETAS.map(([t, x, y, mar, vertical]) => (
      <text aria-hidden="true" class:list={[mar ? 'm-et-mar' : 'm-et']} x={x} y={y} text-anchor={vertical || t.startsWith('Océano') ? undefined : 'middle'} transform={vertical || t.startsWith('Océano') ? `rotate(-90 ${x} ${y})` : undefined}>{t}</text>
    ))}
    <rect class="m-recuadro" x={RECUADRO.x} y={RECUADRO.y} width={RECUADRO.w} height={RECUADRO.h} rx="8" />
    <text aria-hidden="true" class="m-et" x={RECUADRO.x + 8} y={RECUADRO.y + 14}>CANARIAS</text>
    <g filter="url(#m-sombra)">
      {Object.keys(REGIONES).map((n) => {
        const v = cuentas?.[n] ?? 0;
        return cuentas ? (
          <a href={ruta(`/alertas/?ccaa=${encodeURIComponent(n)}`)} aria-label={`${n}: ${numero(v)} alertas`} data-ca={n} data-n={numero(v)}>
            <path class="ca" d={REGIONES[n]} style={`--k:${tono(v)}`} />
          </a>
        ) : <path class:list={clases(n)} d={REGIONES[n]} />;
      })}
    </g>
    <path class="m-prov" d={PROVINCIAS} />
    {([['Ceuta', CEUTA], ['Melilla', MELILLA]] as const).map(([n, [x, y]]) => {
      const v = cuentas?.[n] ?? 0;
      return cuentas ? (
        <a href={ruta(`/alertas/?ccaa=${n}`)} aria-label={`${n}: ${numero(v)} alertas`} data-ca={n} data-n={numero(v)}>
          <circle class="ca m-punto" cx={x} cy={y} r="8" style={`--k:${tono(v)}`} />
        </a>
      ) : <circle class:list={[...clases(n), 'm-punto']} cx={x} cy={y} r="8" />;
    })}
    <g class="m-norte" aria-hidden="true" transform={`translate(${ANCHO - 26} ${ALTO - 42})`}><path d="M0-14 5 4 0 0-5 4Z" /><text y="16" text-anchor="middle">N</text></g>
  </svg>
  {cuentas && (
    <figcaption class="m-leyenda">
      <span>{numero(minimo)}</span><i></i><span>{numero(maximo)} alertas</span>
    </figcaption>
  )}
  {cuentas && <p class="m-globo" data-globo hidden></p>}
</figure>
{cuentas && (
  <ol class="m-lista">
    {ranking.map(([n, v]) => (
      <li><a href={ruta(`/alertas/?ccaa=${encodeURIComponent(n)}`)} data-ca={n}><span>{n}</span><i style={`--w:${((v / maximo) * 100).toFixed(1)}%`}></i><b>{numero(v)}</b></a></li>
    ))}
  </ol>
)}
</div>
