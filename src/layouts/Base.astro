---
import '../estilos/global.css';
import Icono from '../componentes/Icono.astro';
import { estadoFuentes } from '../lib/datos';
import { fechaHora } from '../lib/formato';
import { MENU, NOMBRE, PIE, REPOSITORIO, ruta, TABS } from '../lib/sitio';
import unbounded from '../fuentes/unbounded.woff2?url';
import figtree from '../fuentes/figtree.woff2?url';

interface Props { titulo: string; descripcion: string; ruta: string; jsonld?: unknown[]; tipo?: 'website' | 'article'; rss?: { titulo: string; href: string } }
const { titulo, descripcion, ruta: rutaPagina, jsonld = [], tipo = 'website', rss } = Astro.props;
const canonica = new URL(ruta(rutaPagina), Astro.site).toString();
const imagen = new URL(ruta('/og.png'), Astro.site).toString();
const tituloCompleto = rutaPagina === '/' ? `${NOMBRE}: comprueba si un producto está retirado en España` : `${titulo} · ${NOMBRE}`;
const ultimo = Object.values(estadoFuentes()).map((e) => e.ultimoOk ?? '').sort().at(-1);
const actual = (href: string) => ((href === '/' ? rutaPagina === '/' : rutaPagina.startsWith(href)) ? 'page' : undefined);
---

<!doctype html>
<html lang="es-ES">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="preload" href={unbounded} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={figtree} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={ruta('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={ruta('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={ruta('/apple-touch-icon.png')} />
    <link rel="manifest" href={ruta('/site.webmanifest')} />
    <meta name="theme-color" content="#ffbe2e" />
    <meta property="og:site_name" content={NOMBRE} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={`${NOMBRE}: todas las alertas`} href={ruta('/rss.xml')} />
    {rss && <link rel="alternate" type="application/rss+xml" title={rss.titulo} href={ruta(rss.href)} />}
    {jsonld.map((j) => <script is:inline type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="cab">
      <div class="cab-in">
        <a class="logo" href={ruta('/')} aria-label={`${NOMBRE}, inicio`}>
          <img src={ruta('/marca/isotipo.svg')} alt="" width="44" height="44" />
          <span>Productos<br /><i>Retirados</i></span>
        </a>
        <nav class="menu" aria-label="Principal">
          {MENU.map((m) => <a href={ruta(m.href)} aria-current={actual(m.href)}>{m.texto}</a>)}
        </nav>
        <a class="cta" href={ruta('/comprobar/')}><Icono n="circle-check-big" />Comprobar</a>
      </div>
    </header>
    <p class="aviso-oficial">Web independiente. No es un organismo oficial: comprueba siempre la fuente.</p>
    <main id="contenido">
      <slot />
    </main>
    <footer class="pie oscuro">
      <div>
        <img src={ruta('/marca/logo-oscuro.svg')} alt={NOMBRE} width="167" height="60" loading="lazy" />
        <p class="legal">{NOMBRE} es un proyecto independiente y sin ánimo de lucro: no está vinculado a AESAN, AEMPS, el Ministerio de Consumo ni la Comisión Europea. La información puede contener errores o no estar actualizada. Que un producto no aparezca aquí no significa que sea seguro.</p>
        <p class="legal">Última actualización: {fechaHora(ultimo)}. <a href={REPOSITORIO}>Código abierto</a>.</p>
      </div>
      <div class="pie-col">
        {PIE.map((b) => (
          <section>
            <h2>{b.titulo}</h2>
            <ul>{b.enlaces.map(([h, t]) => <li><a href={ruta(h)}>{t}</a></li>)}</ul>
          </section>
        ))}
      </div>
    </footer>
    <nav class="tabbar" aria-label="Navegación móvil">
      {TABS.map((t) => <a href={ruta(t.href)} aria-current={actual(t.href)}><Icono n={t.icono} />{t.texto}</a>)}
    </nav>
  </body>
</html>

<script>
  import '../scripts/efectos';
  import '../scripts/sugerencias';
</script>
