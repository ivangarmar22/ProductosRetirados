---
import Listado from '../../../componentes/Listado.astro';
import Base from '../../../layouts/Base.astro';
import { alertas } from '../../../lib/datos';
const POR_PAGINA = 50;
export function getStaticPaths() {
  const paginas = Math.ceil(alertas().length / 50);
  return Array.from({ length: Math.max(0, paginas - 1) }, (_, i) => ({ params: { n: String(i + 2) } }));
}
const n = Number(Astro.params.n);
const todas = alertas();
---

<Base titulo={`Alertas, página ${n}`} descripcion={`Listado de alertas y retiradas de productos en España, página ${n}.`} ruta={`/alertas/pagina/${n}/`}>
  <div class="pagina"><Listado alertas={todas.slice((n - 1) * POR_PAGINA, n * POR_PAGINA)} pagina={n} paginas={Math.ceil(todas.length / POR_PAGINA)} /></div>
</Base>
