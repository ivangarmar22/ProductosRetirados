---
import Cabecera from '../componentes/Cabecera.astro';
import Icono from '../componentes/Icono.astro';
import Base from '../layouts/Base.astro';
import { alertas } from '../lib/datos';
import { NEWSLETTER_URL, ruta, TELEGRAM_URL } from '../lib/sitio';
import { CATEGORIAS, nombresAlergenos, slug } from '../../pipeline/normalizar.ts';
const categorias = Object.entries(CATEGORIAS).filter(([k]) => alertas().some((a) => a.categoria.normalizada === k));
---

<Base titulo="Recibe los avisos" descripcion="Recibe las alertas de productos retirados por Telegram, newsletter o RSS, por categoría y por alérgeno." ruta="/avisos/">
  <div class="pagina">
    <Cabecera titulo="Recibe los avisos" icono="bell-ringing" color="agua">
      <p class="entradilla">Elige cómo quieres enterarte. Todos los canales son gratuitos.</p>
    </Cabecera>
    <div class="dos">
      <section class="caja">
        <h2><Icono n="paper-plane-tilt" />Telegram</h2>
        <p>Un mensaje por cada alerta nueva de España, en cuanto la publicamos.</p>
        {TELEGRAM_URL ? <a class="btn" href={TELEGRAM_URL} rel="noopener">Unirme al canal</a> : <p class="nota">El canal estará disponible muy pronto.</p>}
      </section>
      <section class="caja">
        <h2><Icono n="envelope-simple" />Newsletter</h2>
        <p>Un resumen semanal con las alertas de España, en tu correo. Puedes darte de baja cuando quieras.</p>
        {NEWSLETTER_URL ? <a class="btn" href={NEWSLETTER_URL} rel="noopener">Apuntarme</a> : <p class="nota">La newsletter estará disponible muy pronto.</p>}
      </section>
    </div>
    <h2><Icono n="rss" />RSS</h2>
    <p>Para tu lector de noticias. <a href={ruta('/rss.xml')}>RSS de todas las alertas</a>.</p>
    <h3>Por categoría</h3>
    <ul class="rejilla-enlaces">{categorias.map(([k, n]) => <li><a href={ruta(`/rss/categoria/${k}.xml`)}>{n}</a></li>)}</ul>
    <h3>Por alérgeno</h3>
    <ul class="rejilla-enlaces">{nombresAlergenos.map((n) => <li><a href={ruta(`/rss/alergeno/${slug(n)}.xml`)}>{n}</a></li>)}</ul>
  </div>
</Base>
